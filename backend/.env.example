# DPDP Form Auditor - Environment Configuration
APP_NAME=DPDP Form Auditor
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=true

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=dpdp_auditor
MONGODB_SERVER_SELECTION_TIMEOUT_MS=1500

# Persistence Fallback Path (when MongoDB is offline)
LOCAL_STORAGE_PATH=backend/data/audits.json
